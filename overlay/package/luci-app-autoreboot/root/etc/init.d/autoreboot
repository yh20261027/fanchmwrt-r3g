#!/bin/sh /etc/rc.common
# fanchmWrt auto-reboot service
# - manages the cron entry for scheduled daily reboot
# - runs the network watchdog as a procd instance

START=99
STOP=10

CRONTAB=/etc/crontabs/root

sanitize_time() {
	local t hh mm
	t=$(uci -q get autoreboot.global.schedule_time)
	t=${t:-04:30}
	hh=${t%%:*}
	mm=${t##*:}
	case "$hh" in ''|*[!0-9]*) hh=4;; esac
	case "$mm" in ''|*[!0-9]*) mm=30;; esac
	[ "$hh" -gt 23 ] 2>/dev/null && hh=4
	[ "$mm" -gt 59 ] 2>/dev/null && mm=30
	echo "$hh $mm"
}

update_cron() {
	mkdir -p /etc/crontabs
	if [ -f "$CRONTAB" ]; then
		sed -i '/fwx-sched-reboot/d' "$CRONTAB"
	fi
	if [ "$(uci -q get autoreboot.global.schedule_enabled)" = "1" ]; then
		local hm
		hm=$(sanitize_time)
		set -- $hm
		echo "$2 $1 * * * /usr/bin/fwx-sched-reboot" >> "$CRONTAB"
	fi
	/etc/init.d/cron restart 2>/dev/null
}

start_service() {
	update_cron
	if [ "$(uci -q get autoreboot.global.watchdog_enabled)" = "1" ]; then
		procd_open_instance "watchdog"
		procd_set_param command /usr/bin/fwx-watchdog.sh
		procd_set_param respawn 3600 10 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "autoreboot"
}
